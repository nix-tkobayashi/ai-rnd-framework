{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 .claude/scripts/rnd.py:*)",
      "Bash(python3 .claude/scripts/rnd_doctor.py:*)",
      "Bash(python3 .claude/scripts/review_gate.py:*)",
      "Bash(python3 .claude/scripts/generate_index.py:*)",
      "Bash(python3 .claude/scripts/safety_check.py:*)",
      "Bash(python3 .claude/scripts/codex_review.py:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git show:*)",
      "Bash(git worktree list:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(sudo:*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.codex/auth.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/scripts/rnd.py\" brief",
            "timeout": 20,
            "statusMessage": "R&D case を読み込み中..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/safety-gate.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/builder-write-guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
