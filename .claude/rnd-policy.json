{
  "schemaVersion": 1,
  "workspace": "ai-rnd-workspace",
  "layout": {
    "description": "Where the engine and the R&D data live. Scripts read these; change here, not in code. Only uppercase documents (README.md, SPEC.md, CLAUDE.md, CHANGELOG.md, VERSION) stay at the repository root.",
    "engineDir": ".claude",
    "scriptsDir": ".claude/scripts",
    "schemasDir": ".claude/schemas",
    "testsDir": ".claude/tests",
    "dataDir": ".rnd",
    "casesDir": ".rnd/cases",
    "knowledgeDir": ".rnd/knowledge"
  },
  "caseIdPattern": "^RND-[0-9]{8}-[0-9]{3}$",
  "concurrency": {
    "maxAgents": 6,
    "maxResearchers": 3,
    "maxCritics": 2,
    "maxParallelBuilders": 3
  },
  "review": {
    "maxRounds": 5,
    "requiredCleanRounds": {
      "standard": 1,
      "high": 2
    },
    "oscillationReopenThreshold": 2,
    "codexTimeoutSec": 420,
    "codexMaxTimeoutSec": 600,
    "codexSandbox": "read-only",
    "actionableSeverities": [
      "blocking",
      "high",
      "medium",
      "low"
    ],
    "unresolvedStatuses": [
      "open",
      "fixed_pending_review",
      "disputed"
    ],
    "claudeMaySet": [
      "fixed_pending_review",
      "disputed"
    ],
    "codexMaySet": [
      "open",
      "confirmed_fixed",
      "false_positive"
    ],
    "leadMaySet": [
      "accepted_risk"
    ],
    "leadOverrideRequiresNote": true
  },
  "freshness": {
    "maxAgeDays": {
      "fast-moving": 30,
      "normal": 180,
      "stable": 365
    },
    "fastMovingHints": [
      "claude code",
      "codex",
      "aws",
      "llm",
      "kubernetes",
      "gpu",
      "nvidia",
      "cuda",
      "vllm",
      "sglang",
      "anthropic",
      "openai"
    ]
  },
  "stale": {
    "caseInactiveDays": 90
  },
  "protectedPaths": {
    "description": "Paths that R&D agents (Builder, Validator, Reviewer) must never modify. Only the Lead (main session) writes here, through .claude/scripts/rnd.py. Builders may also write under /tmp, /var/tmp, $TMPDIR (scratch files). `gitWriteAgents` lists the agents allowed to commit - only isolated-builder, which works in its own temporary worktree.",
    "builderDenied": [
      ".claude/",
      ".codex/",
      ".rnd/",
      ".git/",
      ".gitignore",
      "CLAUDE.md",
      "CLAUDE.local.md",
      "SPEC.md",
      "README.md",
      "CHANGELOG.md",
      "VERSION"
    ],
    "builderAllowedWithinDenied": [
      ".rnd/cases/RND-*/artifacts/",
      ".rnd/cases/RND-*/experiments/EXP-*/logs/"
    ],
    "readOnlyAgents": [
      "researcher",
      "critic",
      "claim-verifier",
      "experiment-designer",
      "codex-reviewer"
    ],
    "testOnlyAgents": [
      "validator"
    ],
    "gitWriteAgents": [
      "isolated-builder"
    ]
  },
  "safety": {
    "description": "Commands blocked for every agent, including the Lead. Match is regex on the full command string.",
    "blockedCommandPatterns": [
      "\\brm\\s+(?=(?:-\\S+\\s+)*-\\S*[rR])(?=(?:-\\S+\\s+)*-\\S*f)(?:-\\S+\\s+)+['\\\"]?(/|~|\\$HOME|\\.\\.?)['\\\"]?(\\s|$|['\\\"`);|&])",
      "\\brm\\s+(?:-\\S+\\s+)*['\\\"]?(/|~|\\$HOME)['\\\"]?\\s*$",
      "\\bgit\\s+(?:-[cC]\\s+(?:\"[^\"]*\"|'[^']*'|\\S+)\\s+|--git-dir[= ](?:\"[^\"]*\"|'[^']*'|\\S+)\\s+|--work-tree[= ](?:\"[^\"]*\"|'[^']*'|\\S+)\\s+)*push\\b.*(--force|--force-with-lease|-f\\b|\\+refs/)",
      "\\bgit\\s+(?:-[cC]\\s+(?:\"[^\"]*\"|'[^']*'|\\S+)\\s+|--git-dir[= ](?:\"[^\"]*\"|'[^']*'|\\S+)\\s+|--work-tree[= ](?:\"[^\"]*\"|'[^']*'|\\S+)\\s+)*push\\b.*--delete",
      "\\bgit\\s+(?:-[cC]\\s+(?:\"[^\"]*\"|'[^']*'|\\S+)\\s+|--git-dir[= ](?:\"[^\"]*\"|'[^']*'|\\S+)\\s+|--work-tree[= ](?:\"[^\"]*\"|'[^']*'|\\S+)\\s+)*reset\\s+--hard\\b",
      "\\bgit\\s+(?:-[cC]\\s+(?:\"[^\"]*\"|'[^']*'|\\S+)\\s+|--git-dir[= ](?:\"[^\"]*\"|'[^']*'|\\S+)\\s+|--work-tree[= ](?:\"[^\"]*\"|'[^']*'|\\S+)\\s+)*clean\\b.*-[a-zA-Z]*f",
      "\\bgit\\s+(?:-[cC]\\s+(?:\"[^\"]*\"|'[^']*'|\\S+)\\s+|--git-dir[= ](?:\"[^\"]*\"|'[^']*'|\\S+)\\s+|--work-tree[= ](?:\"[^\"]*\"|'[^']*'|\\S+)\\s+)*branch\\s+-D\\b",
      "\\bgit\\s+(?:-[cC]\\s+(?:\"[^\"]*\"|'[^']*'|\\S+)\\s+|--git-dir[= ](?:\"[^\"]*\"|'[^']*'|\\S+)\\s+|--work-tree[= ](?:\"[^\"]*\"|'[^']*'|\\S+)\\s+)*checkout\\s+--\\s+\\.",
      "\\bgit\\s+(?:-[cC]\\s+(?:\"[^\"]*\"|'[^']*'|\\S+)\\s+|--git-dir[= ](?:\"[^\"]*\"|'[^']*'|\\S+)\\s+|--work-tree[= ](?:\"[^\"]*\"|'[^']*'|\\S+)\\s+)*restore\\s+(--staged\\s+)?\\.",
      "\\bgit\\s+(?:-[cC]\\s+(?:\"[^\"]*\"|'[^']*'|\\S+)\\s+|--git-dir[= ](?:\"[^\"]*\"|'[^']*'|\\S+)\\s+|--work-tree[= ](?:\"[^\"]*\"|'[^']*'|\\S+)\\s+)*filter-branch\\b",
      "\\bgit\\s+(?:-[cC]\\s+(?:\"[^\"]*\"|'[^']*'|\\S+)\\s+|--git-dir[= ](?:\"[^\"]*\"|'[^']*'|\\S+)\\s+|--work-tree[= ](?:\"[^\"]*\"|'[^']*'|\\S+)\\s+)*worktree\\s+remove\\b.*--force",
      "\\bgit\\s+(?:-[cC]\\s+(?:\"[^\"]*\"|'[^']*'|\\S+)\\s+|--git-dir[= ](?:\"[^\"]*\"|'[^']*'|\\S+)\\s+|--work-tree[= ](?:\"[^\"]*\"|'[^']*'|\\S+)\\s+)*update-ref\\s+-d\\b",
      "\\bmkfs(\\.|\\s)",
      "\\bdd\\s+.*of=/dev/",
      ">\\s*/dev/sd",
      "\\bchmod\\s+(-R\\s+)?777\\s+/",
      "\\bchown\\s+-R\\b.*\\s/\\s*$",
      "(^|[;&|(\\n]\\s*)(shutdown|reboot|halt|poweroff)(\\s|$)",
      "\\bsystemctl\\s+(stop|disable|mask)\\b",
      "\\bkill\\s+-9\\s+-1\\b",
      "\\bpkill\\s+-9\\s+-f\\s+(claude|node)\\b",
      "\\b(curl|wget)\\b[^|]*\\|\\s*(sudo\\s+)?(ba|z|da)?sh\\b",
      "(^|[;&|(\\n]\\s*)sudo\\s+",
      "\\bcrontab\\s+-r\\b",
      "\\bhistory\\s+-c\\b",
      "\\btruncate\\b.*\\s(/|~)",
      ":\\(\\)\\s*\\{\\s*:\\|:&\\s*\\};:"
    ],
    "blockedPathWrites": [
      "/etc/",
      "/usr/",
      "/bin/",
      "/sbin/",
      "/boot/",
      "/dev/",
      "/proc/",
      "/sys/",
      "~/.ssh/",
      "~/.aws/",
      "~/.codex/auth.json",
      "~/.claude/settings.json"
    ],
    "secretPatterns": [
      "AKIA[0-9A-Z]{16}",
      "-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----",
      "sk-[A-Za-z0-9]{20,}",
      "ghp_[A-Za-z0-9]{36}",
      "xox[baprs]-[A-Za-z0-9-]{10,}"
    ]
  },
  "reviewerShell": {
    "description": "Commands the Codex Reviewer wrapper may run. Everything else is denied. Validator additionally gets the test profile.",
    "allowedPrefixes": [
      "git diff",
      "git --no-pager diff",
      "git log",
      "git --no-pager log",
      "git show",
      "git --no-pager show",
      "git status",
      "git blame",
      "git --no-pager blame",
      "git rev-parse",
      "git ls-files",
      "git worktree list",
      "git branch --show-current",
      "cat ",
      "head ",
      "tail ",
      "less ",
      "ls",
      "find ",
      "grep ",
      "rg ",
      "wc ",
      "diff ",
      "stat ",
      "file ",
      "tree",
      "pwd",
      "echo ",
      "which ",
      "sha256sum ",
      "md5sum ",
      "jq ",
      "python3 .claude/scripts/codex_review.py",
      "python .claude/scripts/codex_review.py",
      "python3 .claude/scripts/review_gate.py",
      "python .claude/scripts/review_gate.py",
      "python3 .claude/scripts/rnd.py show",
      "python .claude/scripts/rnd.py show",
      "python3 .claude/scripts/rnd.py resume",
      "python .claude/scripts/rnd.py resume",
      "python3 .claude/scripts/rnd.py findings",
      "python .claude/scripts/rnd.py findings",
      "python3 .claude/scripts/safety_check.py",
      "python .claude/scripts/safety_check.py",
      "codex --version",
      "codex exec",
      "python3 .claude/scripts/rnd.py agent status",
      "python .claude/scripts/rnd.py agent status"
    ],
    "validatorExtraPrefixes": [
      "python3 -m pytest",
      "python -m pytest",
      "pytest",
      "python3 -m unittest",
      "python -m unittest",
      "python3 .claude/scripts/rnd.py validate",
      "python .claude/scripts/rnd.py validate",
      "npm test",
      "npm run test",
      "npx jest",
      "npx vitest",
      "npx playwright test",
      "node --test",
      "go test",
      "cargo test",
      "make test",
      "make check",
      "bash .claude/tests/",
      "sh .claude/tests/",
      "python3 .claude/tests/",
      "python .claude/tests/",
      "python3 .rnd/",
      "python .rnd/",
      "bash .rnd/",
      "node .rnd/",
      "docker compose ps",
      "docker ps",
      "kubectl get",
      "aws sts get-caller-identity",
      "python3 .claude/scripts/rnd.py tests",
      "python .claude/scripts/rnd.py tests",
      "python3 .claude/scripts/rnd.py evidence check",
      "python .claude/scripts/rnd.py evidence check",
      "python3 -c",
      "python -c"
    ],
    "deniedTokens": [
      ">",
      ">>",
      "| tee",
      "sed -i",
      "perl -i",
      "rm ",
      "mv ",
      "cp ",
      "mkdir ",
      "touch ",
      "chmod ",
      "chown ",
      "ln ",
      "git add",
      "git commit",
      "git push",
      "git checkout",
      "git switch",
      "git restore",
      "git stash",
      "git merge",
      "git rebase",
      "git reset",
      "git apply",
      "patch ",
      "pip install",
      "npm install",
      "npm i ",
      "apt",
      "brew ",
      "install ",
      "-delete",
      "-exec",
      "-execdir",
      "-ok",
      "--output",
      "--output-file",
      "-fprint"
    ]
  }
}
